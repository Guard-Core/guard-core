{
  "suite": "misconfiguration_decorators",
  "kind": "misconfiguration",
  "spec_version": "4.1.0",
  "engine_version": "5.0.0",
  "doc": "Misconfiguration suite. Each case drives the reference engine twice on the same input: once with fail_on_misconfiguration=False (expected.reported) and once with fail_on_misconfiguration=True (expected.raises, expected.fatal). A pair is [kind, subject]; subject is null when the kind has none. The kinds block lists every kind the file can hold with its severity (error or warn), scope, what the subject is and what the kind means. Only kind and subject are normative. Input: config as in misconfiguration_config, geo (null or \"stub\", a configured GeoIP handler) and decorators, a list of {name, args} applied one by one to a fresh function with the Python keyword names. reported is the union over the decorators and fatal the union of what each decorator's raise carries.",
  "kinds": {
    "decorator.allow_countries.empty_list": {
      "severity": "error",
      "scope": "decorators",
      "subject": "null",
      "description": "the country list is empty"
    },
    "decorator.behavior_rule.non_positive": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the decorator name",
      "description": "a behavior decorator has a threshold or a window below 1"
    },
    "decorator.block_clouds.empty_list": {
      "severity": "error",
      "scope": "decorators",
      "subject": "null",
      "description": "a provider list is given and empty"
    },
    "decorator.block_clouds.unknown_provider": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the unknown selectors as given, sorted and joined by a comma and a space",
      "description": "a provider selector is unknown"
    },
    "decorator.block_countries.empty_list": {
      "severity": "error",
      "scope": "decorators",
      "subject": "null",
      "description": "the country list is empty"
    },
    "decorator.bypass.unknown_check": {
      "severity": "warn",
      "scope": "decorators",
      "subject": "the unknown checks as given, sorted and joined by a comma and a space",
      "description": "a bypass names a check that does not exist, so it is ignored"
    },
    "decorator.country_rule.geoip_download_extras_missing": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the decorator, for example @block_countries",
      "description": "ipinfo_token is set and the GeoIP download extras are not installed; host dependent, never pinned in the corpus",
      "fatal_only": true,
      "host_dependent": true
    },
    "decorator.country_rule.no_geoip_source": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the decorator, for example @block_countries",
      "description": "a country rule is declared and no GeoIP source is configured; checked only while fail_on_misconfiguration is True, so it is fatal and never merely reported",
      "fatal_only": true
    },
    "decorator.detection_exclusion.param_not_in_template": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the declared parameter name",
      "description": "a path_params name of @detection_exclusion is not a parameter of the route template, so it exempts nothing"
    },
    "decorator.detection_exclusion.param_without_literal_segment": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the declared parameter name",
      "description": "a path_params name of @detection_exclusion has no literal segment before it in the route template, so it would exempt the whole path from the probe rows"
    },
    "decorator.geo_rate_limit.below_one": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the country key as given",
      "description": "an entry has a limit or a window below 1"
    },
    "decorator.max_request_size.zero": {
      "severity": "warn",
      "scope": "decorators",
      "subject": "null",
      "description": "max_request_size(0) refuses any request body"
    },
    "decorator.rate_limit.below_one": {
      "severity": "error",
      "scope": "decorators",
      "subject": "null",
      "description": "requests or window is below 1"
    },
    "decorator.require_auth.capitalized_scheme": {
      "severity": "warn",
      "scope": "decorators",
      "subject": "null",
      "description": "require_auth names a built-in scheme with other capitalization"
    },
    "decorator.require_ip.empty_whitelist": {
      "severity": "error",
      "scope": "decorators",
      "subject": "null",
      "description": "a whitelist is given and empty"
    },
    "decorator.require_ip.invalid_entry": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the entry as given",
      "description": "a whitelist or blacklist entry is not an IP address or CIDR network"
    },
    "decorator.suspicious_frequency.product_below_one": {
      "severity": "error",
      "scope": "decorators",
      "subject": "null",
      "description": "max_frequency times window is below 1"
    },
    "decorator.time_window.invalid_time": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the argument name (start_time or end_time)",
      "description": "start_time or end_time is not HH:MM"
    },
    "decorator.time_window.unknown_timezone": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the timezone as given",
      "description": "the timezone is not an IANA zone"
    }
  },
  "cases": [
    {
      "id": "time_window_invalid_start",
      "input": {
        "config": {
          "enable_redis": false,
          "rate_limit": 10,
          "ban_on_hostile_signals": false
        },
        "geo": null,
        "decorators": [
          {
            "name": "time_window",
            "args": {
              "start_time": "25:00",
              "end_time": "17:00"
            }
          }
        ]
      },
      "expected": {
        "raises": true,
        "reported": [
          [
            "decorator.time_window.invalid_time",
            "start_time"
          ]
        ],
        "fatal": [
          [
            "decorator.time_window.invalid_time",
            "start_time"
          ]
        ]
      }
    },
    {
