    {
      "id": "ctx_trav_url_path",
      "input": {
        "content": "/files?name=../../etc/passwd",
        "context": "url_path"
      },
      "expected": {
        "is_threat": true,
        "threat_score": 1.0,
        "threats": [
          {
            "type": "regex",
            "pattern": "(?:\\.\\.\\/|\\.\\.\\\\)(?:\\.\\.\\/|\\.\\.\\\\)+",
            "match": "../../",
            "position": 12,
            "category": "dir_traversal",
            "weight": 1.0
          },
          {
            "type": "regex",
            "pattern": "\\A(?:(?!\\n).)*etc/(?:passwd|shadow|group|hosts|motd|issue|mysql/my\\.cnf|ssh/ssh_config)(?:[&#;,\\\"'<>]|\\s*\\Z)",
            "match": "/files?name=../../etc/passwd",
            "position": 0,
            "category": "dir_traversal",
            "weight": 1.0
          }
        ],
        "original_length": 28,
        "processed_length": 28,
        "detection_method": "enhanced"
      }
    },
