{
  "suite": "misconfiguration_runtime",
  "kind": "misconfiguration",
  "spec_version": "4.1.0",
  "engine_version": "5.0.0",
  "doc": "Misconfiguration suite. Each case drives the reference engine twice on the same input: once with fail_on_misconfiguration=False (expected.reported) and once with fail_on_misconfiguration=True (expected.raises, expected.fatal). A pair is [kind, subject]; subject is null when the kind has none. The kinds block lists every kind the file can hold with its severity (error or warn), scope, what the subject is and what the kind means. Only kind and subject are normative. Tier 2: each case names a seam (ban_thresholds, nat64, redis_handler, country_decorators, ipv6_prefix_length, endpoint_key_routes, exclude_paths_routes) and gives that seam's stubs; a port wires the same stubs around its own reporter. The reference reports a default redis_prefix once per process; a runner resets that memory per case.",
  "kinds": {
    "auto_ban_threshold.unreachable": {
      "severity": "error",
      "scope": "runtime",
      "subject": "null",
      "description": "auto_ban_threshold is above the strikes one client can produce in the window"
    },
    "endpoint_rate_limits.matches_no_route": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the endpoint_rate_limits key",
      "description": "a key matches no registered route"
    },
    "endpoint_rate_limits.resolve_route_raised": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the endpoint_rate_limits key",
      "description": "resolve_route raised for a key"
    },
    "exclude_paths.matches_no_route": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the exclude_paths entry",
      "description": "an entry matches no registered route"
    },
    "exclude_paths.static_route_prefixes_raised": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "static_route_prefixes raised during the exclude_paths route check"
    },
    "ipv6_prefix_length.redis_mismatch": {
      "severity": "error",
      "scope": "runtime",
      "subject": "null",
      "description": "ipv6_prefix_length differs from the value recorded in Redis"
    },
    "nat64_prefixes.invalid_entry": {
      "severity": "error",
      "scope": "runtime",
      "subject": "the nat64_prefixes entry",
      "description": "an entry is not an IPv6 prefix of an RFC 6052 length"
    },
    "redis_handler.is_connected_async": {
      "severity": "error",
      "scope": "runtime",
      "subject": "null",
      "description": "redis_fail_open is on and the handler defines is_connected as async"
    },
    "redis_handler.missing_members": {
      "severity": "error",
      "scope": "runtime",
      "subject": "null",
      "description": "the Redis handler lacks members of the handler protocol"
    },
    "route.country_rule_without_geoip": {
      "severity": "error",
      "scope": "runtime",
      "subject": "the route id",
      "description": "a route uses a country rule and no GeoIP source is configured"
    },
    "threat_ban_config.unreachable": {
      "severity": "error",
      "scope": "runtime",
      "subject": "the threat_ban_config category",
      "description": "a category threshold is above the strikes one client can produce in the window"
    }
  },
  "cases": [
    {
      "id": "ban_threshold_reachable",
      "input": {
        "seam": "ban_thresholds",
        "config": {
          "enable_redis": false,
          "rate_limit": 10,
          "ban_on_hostile_signals": false,
          "rate_limit_window": 60,
          "auto_ban_threshold": 100
        }
      },
      "expected": {
        "raises": false,
        "reported": [],
        "fatal": []
      }
    },
    {
      "id": "auto_ban_threshold_unreachable",
      "input": {
        "seam": "ban_thresholds",
        "config": {
          "enable_redis": false,
          "rate_limit": 10,
          "ban_on_hostile_signals": false,
          "rate_limit_window": 60,
          "auto_ban_threshold": 100000
        }
      },
      "expected": {
        "raises": true,
        "reported": [
          [
            "auto_ban_threshold.unreachable",
            null
          ]
        ],
        "fatal": [
          [
            "auto_ban_threshold.unreachable",
            null
          ]
        ]
      }
    },
    {
      "id": "threat_ban_threshold_unreachable",
      "input": {
        "seam": "ban_thresholds",
        "config": {
          "enable_redis": false,
          "rate_limit": 10,
          "ban_on_hostile_signals": false,
          "rate_limit_window": 60,
          "auto_ban_threshold": 100,
          "threat_ban_config": {
            "sqli": {
              "threshold": 100000,
              "duration": 3600
            }
          }
        }
      },
      "expected": {
        "raises": true,
        "reported": [
          [
            "threat_ban_config.unreachable",
            "sqli"
          ]
        ],
        "fatal": [
          [
            "threat_ban_config.unreachable",
            "sqli"
          ]
        ]
      }
    },
    {
