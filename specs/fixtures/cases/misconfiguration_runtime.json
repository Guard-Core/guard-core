{
  "suite": "misconfiguration_runtime",
  "kind": "misconfiguration",
  "spec_version": "4.1.0",
  "engine_version": "5.0.0",
  "doc": "Misconfiguration suite. Each case drives the reference engine twice on the same input: once with fail_on_misconfiguration=False (expected.reported) and once with fail_on_misconfiguration=True (expected.raises, expected.fatal). A pair is [kind, subject]; subject is null when the kind has none. The kinds block lists every kind the file can hold with its severity (error or warn), scope, what the subject is and what the kind means. Only kind and subject are normative. Tier 2: each case names a seam (ban_thresholds, nat64, redis_handler, country_decorators, ipv6_prefix_length, endpoint_key_routes, exclude_paths_routes, declared_path_params, lazy_init_without_redis, ipinfo_download_url_ignored, purge_on_start_left_set, security_headers_config, cors_response_wildcard, redis_prefix_split, unenforced_ban, route_unknown_to_decorator, redis_url_none, cors_override, cors_header_value, dynamic_rules_agent, forwarded_header, body_reader_fallback, throttle_without_middleware) and gives that seam's stubs; a port wires the same stubs around its own reporter. The reference reports a default redis_prefix once per process; a runner resets that memory per case.",
  "kinds": {
    "auto_ban_threshold.unreachable": {
      "severity": "error",
      "scope": "runtime",
      "subject": "null",
      "description": "auto_ban_threshold is above the strikes one client can produce in the window"
    },
    "ban.unenforced_for_app": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "a stored ban is on a trusted proxy or loopback address of the app, so the app does not enforce it"
    },
    "behavior_rules.throttle_needs_middleware": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "a throttle behavior rule is declared and the adapter passes no middleware, so it is only logged"
    },
    "body_reader.no_bounded_reader": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "the request class has no bounded body reader, so the body is read in full with no idle deadline"
    },
    "body_reader.prefix_without_idle_deadline": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "the request class has read_body_prefix but not read_body_prefix_until_idle, so a stalled body has no idle deadline"
    },
    "cors.header_value_invalid": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "a configured CORS value is not a valid header value, so no CORS header is emitted"
    },
    "cors.wildcard_origin_with_credentials_blocked": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "a response with an Origin header meets a wildcard origin with credentials, and no CORS header is emitted"
    },
    "cors.wildcard_origin_with_credentials_dropped": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "a headers manager is given a wildcard origin and credentials, and drops the credentials"
    },
    "cors_override.fields_refused": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "a configure() override gives CORS fields this app refuses, and they are dropped"
    },
    "cors_override.refused": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "a configure() override of the CORS settings is refused, and the app keeps its own"
    },
    "cors_override.widens": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "a configure() override widens the CORS of this app"
    },
    "decorator.detection_exclusion.param_not_in_template": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the declared parameter name",
      "description": "a path_params name of @detection_exclusion is not a parameter of the route template, so it exempts nothing"
    },
    "decorator.detection_exclusion.param_without_literal_segment": {
      "severity": "error",
      "scope": "decorators",
      "subject": "the declared parameter name",
      "description": "a path_params name of @detection_exclusion has no literal segment before it in the route template, so it would exempt the whole path from the probe rows"
    },
    "dynamic_rules.enabled_without_agent": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "enable_dynamic_rules is on and the app has no agent handler, so dynamic rules never arrive"
    },
    "endpoint_rate_limits.matches_no_route": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the endpoint_rate_limits key",
      "description": "a key matches no registered route"
    },
    "endpoint_rate_limits.resolve_route_raised": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the endpoint_rate_limits key",
      "description": "resolve_route raised for a key"
    },
    "exclude_paths.matches_no_route": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the exclude_paths entry",
      "description": "an entry matches no registered route"
    },
    "exclude_paths.static_route_prefixes_raised": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "static_route_prefixes raised during the exclude_paths route check"
    },
    "forwarded_header.preempted_by_server": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the trusted_proxy_depth setting",
      "description": "the application server resolved the client from X-Forwarded-For before guard- core ran"
    },
    "ipinfo_download_url.ignored": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the ignored ipinfo_download_url",
      "description": "ipinfo_download_url differs from the URL the database file already downloads from, so it is ignored"
    },
    "ipv6_prefix_length.redis_mismatch": {
      "severity": "error",
      "scope": "runtime",
      "subject": "null",
      "description": "ipv6_prefix_length differs from the value recorded in Redis"
    },
    "lazy_init.without_redis": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "lazy_init has no effect without Redis while cloud ranges or a GeoIP handler are configured"
    },
    "nat64_prefixes.invalid_entry": {
      "severity": "error",
      "scope": "runtime",
      "subject": "the nat64_prefixes entry",
      "description": "an entry is not an IPv6 prefix of an RFC 6052 length"
    },
    "purge_dynamic_rules_on_start.left_set": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the purge_dynamic_rules_on_start target as configured",
      "description": "purge_dynamic_rules_on_start is set at start"
    },
    "redis_handler.is_connected_async": {
      "severity": "error",
      "scope": "runtime",
      "subject": "null",
      "description": "redis_fail_open is on and the handler defines is_connected as async"
    },
    "redis_handler.missing_members": {
      "severity": "error",
      "scope": "runtime",
      "subject": "null",
      "description": "the Redis handler lacks members of the handler protocol"
    },
    "redis_prefix.split_connection": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the shared redis_prefix",
      "description": "two apps use one redis_prefix on different Redis connections"
    },
    "redis_url.none_with_enable_redis": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "enable_redis is on and redis_url is None, so no Redis connection is made"
    },
    "route.country_rule_without_geoip": {
      "severity": "error",
      "scope": "runtime",
      "subject": "the route id",
      "description": "a route uses a country rule and no GeoIP source is configured"
    },
    "route.unknown_to_decorator": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the route id",
      "description": "a route carries a route id this SecurityDecorator does not know, so none of its decorators apply"
    },
    "security_headers.csp_unsafe_source": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the CSP directive",
      "description": "a csp directive holds 'unsafe-inline' or 'unsafe-eval', and is kept as given"
    },
    "security_headers.hsts_preload_max_age_too_low": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "hsts preload is asked for with a max_age below 31536000, and preload is turned off"
    },
    "security_headers.hsts_preload_without_include_subdomains": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "null",
      "description": "hsts preload is asked for without includeSubDomains, and includeSubDomains is turned on"
    },
    "threat_ban_config.unreachable": {
      "severity": "error",
      "scope": "runtime",
      "subject": "the threat_ban_config category",
      "description": "a category threshold is above the strikes one client can produce in the window"
    },
    "trusted_proxy_depth.chain_too_short": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the trusted_proxy_depth setting",
      "description": "the X-Forwarded-For chain is shorter than trusted_proxy_depth"
    },
    "trusted_proxy_depth.overcounts_hops": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the trusted_proxy_depth setting",
      "description": "trusted_proxy_depth is higher than the proxy hops listed in trusted_proxies"
    },
    "trusted_proxy_depth.selects_trusted_proxy": {
      "severity": "warn",
      "scope": "runtime",
      "subject": "the trusted_proxy_depth setting",
      "description": "trusted_proxy_depth selects an address that is itself a trusted proxy"
    }
  },
  "cases": [
    {
      "id": "ban_threshold_reachable",
      "input": {
        "seam": "ban_thresholds",
        "config": {
          "enable_redis": false,
          "rate_limit": 10,
          "ban_on_hostile_signals": false,
          "rate_limit_window": 60,
          "auto_ban_threshold": 100
        }
      },
      "expected": {
        "raises": false,
        "reported": [],
        "fatal": []
      }
    },
    {
      "id": "auto_ban_threshold_unreachable",
      "input": {
