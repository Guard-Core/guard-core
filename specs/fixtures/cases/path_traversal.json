  "cases": [
    {
      "id": "trav_double_dot_slash",
      "input": {
        "content": "/download?file=../../etc/passwd",
        "context": "url_path"
      },
      "expected": {
        "is_threat": true,
        "threat_score": 1.0,
        "threats": [
          {
            "type": "regex",
            "pattern": "(?:\\.\\.\\/|\\.\\.\\\\)(?:\\.\\.\\/|\\.\\.\\\\)+",
            "match": "../../",
            "position": 15,
            "category": "dir_traversal",
            "weight": 1.0
          },
          {
            "type": "regex",
            "pattern": "\\A(?:(?!\\n).)*etc/(?:passwd|shadow|group|hosts|motd|issue|mysql/my\\.cnf|ssh/ssh_config)(?:[&#;,\\\"'<>]|[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]|\\s*\\Z)",
            "match": "/download?file=../../etc/passwd",
            "position": 0,
            "category": "dir_traversal",
            "weight": 1.0
          }
        ],
        "original_length": 31,
        "processed_length": 31,
        "detection_method": "enhanced"
      }
    },
