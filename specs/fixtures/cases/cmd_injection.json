{
  "suite": "cmd_injection",
  "kind": "detect",
  "spec_version": "4.1.0",
  "engine_version": "4.3.2",
  "cases": [
    {
      "id": "cmdi_semicolon_cat",
      "input": {
        "content": "; cat /etc/passwd",
        "context": "request_body"
      },
      "expected": {
        "is_threat": true,
        "threat_score": 1.0,
        "threats": [
          {
            "type": "regex",
            "pattern": "[;|&]\\s*(?:ls|cat|rm|id|whoami|uname|wget|curl|nc|netcat|socat|bash|sh|python|perl)\\b",
            "match": "; cat",
            "position": 0,
            "category": "cmd_injection",
            "weight": 1.0
          },
          {
            "type": "regex",
            "pattern": "\\A(?:(?!\\n).)*etc/(?:passwd|shadow|group|hosts|motd|issue|mysql/my\\.cnf|ssh/ssh_config)(?:[&#;,\\\"'<>]|\\s*\\Z)",
            "match": "; cat /etc/passwd",
            "position": 0,
            "category": "dir_traversal",
            "weight": 1.0
          }
        ],
        "original_length": 17,
        "processed_length": 17,
        "detection_method": "enhanced"
      }
    },
    {
      "id": "cmdi_dollar_paren",
      "input": {
        "content": "$(whoami)",
        "context": "query_param"
      },
      "expected": {
        "is_threat": true,
        "threat_score": 1.0,
        "threats": [
          {
            "type": "regex",
            "pattern": "\\$\\((?:[^()\\\\\\n]|\\\\.)*\\)|\\$\\{(?:[^{}\\\\\\n]|\\\\.)*\\}",
            "match": "$(whoami)",
            "position": 0,
            "category": "cmd_injection",
            "weight": 1.0
          }
        ],
        "original_length": 9,
        "processed_length": 9,
        "detection_method": "enhanced"
      }
    },
    {
      "id": "cmdi_backtick",
      "input": {
        "content": "`id`",
        "context": "query_param"
      },
      "expected": {
        "is_threat": true,
        "threat_score": 1.0,
        "threats": [
          {
            "type": "regex",
            "pattern": "\\A\\s*(?:[;&|]\\s*)*`\\s*(?:[A-Za-z0-9_./~]|\\$[({])(?:[^`\\\\\\n]|\\\\.)*(?:\\n\\s*)?`(?:\\s*[;&|]\\s*`\\s*(?:[A-Za-z0-9_./~]|\\$[({])(?:[^`\\\\\\n]|\\\\.)*(?:\\n\\s*)?`)*\\s*(?:[;&|]\\s*)*\\Z",
            "match": "`id`",
            "position": 0,
            "category": "cmd_injection",
            "weight": 1.0
          }
        ],
        "original_length": 4,
        "processed_length": 4,
        "detection_method": "enhanced"
      }
    },
