{
  "suite": "inclusion_sensitive_recon",
  "kind": "detect",
  "spec_version": "4.1.0",
  "engine_version": "4.3.2",
  "cases": [
    {
      "id": "incl_php_filter",
      "input": {
        "content": "php://filter/convert.base64-encode/resource=index",
        "context": "query_param"
      },
      "expected": {
        "is_threat": true,
        "threat_score": 1.0,
        "threats": [
          {
            "type": "regex",
            "pattern": "(?:php|data|zip|rar|file|glob|expect|input|phpinfo|zlib|phar|ssh2|rar|ogg|expect)://[^\\s]+",
            "match": "php://filter/convert.base64-encode/resource=index",
            "position": 0,
            "category": "file_inclusion",
            "weight": 1.0
          }
        ],
        "original_length": 49,
        "processed_length": 49,
        "detection_method": "enhanced"
      }
    },
    {
