    {
      "id": "incl_remote_http",
      "input": {
        "content": "http://10.0.0.1/shell.txt",
        "context": "query_param"
      },
      "expected": {
        "is_threat": true,
        "threat_score": 1.0,
        "threats": [
          {
            "type": "regex",
            "pattern": "(?:^|\\s|/)(?:(?<=://)[^\\s/@]*@)?(?:localhost\\.?|127\\.0\\.0\\.1|0\\.0\\.0\\.0|\\[::(?:\\d*)\\]|\\[::ffff:127\\.0\\.0\\.1\\]|169\\.254(?:\\.\\d{1,3}){2}|192\\.168(?:\\.\\d{1,3}){2}|10(?:\\.\\d{1,3}){3}|172\\.(?:1[6-9]|2[0-9]|3[01])(?:\\.\\d{1,3}){2}|metadata\\.google\\.internal|metadata\\.goog|100\\.100\\.100\\.200)(?::\\d+)?(?:\\s|$|/)",
            "match": "/10.0.0.1/",
            "position": 6,
            "category": "ssrf",
            "weight": 1.0
          },
          {
            "type": "regex",
            "pattern": "://(?:[^/@\\s]*@)?((?:0[xX][0-9a-fA-F]+|0[0-7]+|[1-9]\\d*|0)(?:\\.(?:0[xX][0-9a-fA-F]+|0[0-7]+|[1-9]\\d*|0)){0,3})(?=[:/\\s]|$)",
            "match": "://10.0.0.1",
            "position": 4,
            "category": "ssrf",
            "weight": 1.0
          }
        ],
        "original_length": 25,
        "processed_length": 25,
        "detection_method": "enhanced"
      }
    },
