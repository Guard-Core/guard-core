        "behavior_scan_response_body": true,
        "global_behavior_rules": [
          {
            "rule_type": "return_pattern",
            "threshold": 2,
            "window": 3600,
            "pattern": "status:404",
            "action": "ban",
            "ban_duration": 900
          }
        ]
      },
      "geo_countries": {},
      "routes": {},
