{
  "suite": "misconfiguration_dynamic_rules",
  "kind": "misconfiguration",
  "spec_version": "4.1.0",
  "engine_version": "5.0.0",
  "doc": "Misconfiguration suite. Each case drives the reference engine twice on the same input: once with fail_on_misconfiguration=False (expected.reported) and once with fail_on_misconfiguration=True (expected.raises, expected.fatal). A pair is [kind, subject]; subject is null when the kind has none. The kinds block lists every kind the file can hold with its severity (error or warn), scope, what the subject is and what the kind means. Only kind and subject are normative. Input: dynamic_rules, the DynamicRulesProtocol fields the validator reads; a field the case leaves out is empty or null. Every problem rejects the whole rule set, so fatal repeats reported and the flag changes nothing.",
  "kinds": {
    "dynamic_rules.auto_ban_duration.below_one": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "null",
      "description": "auto_ban_duration is below 1"
    },
    "dynamic_rules.blocked_cloud_providers.unknown_provider": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "the provider as given",
      "description": "a provider selector is unknown"
    },
    "dynamic_rules.blocked_countries.invalid_code": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "the code as given",
      "description": "an entry is not a two-letter country code"
    },
    "dynamic_rules.emergency_whitelist.invalid_entry": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "the entry as given",
      "description": "an entry is not an IP address or CIDR range"
    },
    "dynamic_rules.global_rate_limit.below_one": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "null",
      "description": "global_rate_limit is below 1"
    },
    "dynamic_rules.global_rate_window.below_one": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "null",
      "description": "global_rate_window is below 1"
    },
    "dynamic_rules.ip_ban_duration.below_one": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "null",
      "description": "ip_ban_duration is below 1"
    },
    "dynamic_rules.ip_blacklist.invalid_entry": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "the entry as given",
      "description": "an entry is not an IP address or CIDR range"
    },
    "dynamic_rules.ip_whitelist.invalid_entry": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "the entry as given",
      "description": "an entry is not an IP address or CIDR range"
    },
    "dynamic_rules.whitelist_countries.invalid_code": {
      "severity": "error",
      "scope": "dynamic_rules",
      "subject": "the code as given",
      "description": "an entry is not a two-letter country code"
    },
    "endpoint_rate_limits.below_one": {
      "severity": "error",
      "scope": "config",
      "subject": "the endpoint_rate_limits key",
      "description": "enable_rate_limiting is on and an entry has a limit or a window below 1"
    },
    "endpoint_rate_limits.router_template": {
      "severity": "error",
      "scope": "config",
      "subject": "the endpoint_rate_limits key",
      "description": "a key is a router template, a regex route or a glob, which matches only that literal text"
    },
    "endpoint_rate_limits.routing_anomaly": {
      "severity": "error",
      "scope": "config",
      "subject": "the endpoint_rate_limits key",
      "description": "a key has a dot segment, an empty segment, a backslash or an encoded dot or separator in any decoding round"
    }
  },
  "cases": [
    {
      "id": "empty_rules",
      "input": {
        "dynamic_rules": {}
