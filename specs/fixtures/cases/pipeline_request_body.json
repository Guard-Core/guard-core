{
  "suite": "pipeline_request_body",
  "kind": "pipeline",
  "spec_version": "4.1.0",
  "engine_version": "4.4.0",
  "cases": [
    {
      "id": "chunked_body_over_limit_is_oversize",
      "config": {},
      "geo_countries": {},
      "routes": {
        "/upload": {
          "max_request_size": 10
        }
      },
      "drives": [
        {
          "client_ip": "192.0.2.10",
          "url_path": "/upload",
          "method": "POST",
          "headers": {
            "Transfer-Encoding": "chunked"
          },
          "body": "xxxxxxxxxxxxxxxx"
        }
      ],
      "expected": [
        {
          "status": 413,
          "body": "Request too large",
          "headers": {
            "X-Content-Type-Options": "nosniff",
            "X-Frame-Options": "SAMEORIGIN",
            "X-XSS-Protection": "0",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
            "X-Permitted-Cross-Domain-Policies": "none",
            "X-Download-Options": "noopen",
            "Cross-Origin-Opener-Policy": "same-origin",
            "Cross-Origin-Resource-Policy": "same-site",
            "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
          },
          "events": [
            [
              "content_filtered",
              "request_blocked"
            ]
          ],
          "on_block": [
            {
              "check_name": "request_size_content",
              "reason": "Request body exceeds 10 bytes: 10",
              "trigger_info": "",
              "passive_mode": false,
              "client_ip": "192.0.2.10",
              "path": "/upload",
              "method": "POST",
              "status_code": 413
            }
          ]
        }
      ]
    },
    {
      "id": "chunked_body_at_limit_passes",
      "config": {},
      "geo_countries": {},
      "routes": {
        "/upload": {
          "max_request_size": 16
        }
      },
      "drives": [
        {
          "client_ip": "192.0.2.10",
          "url_path": "/upload",
          "method": "POST",
          "headers": {
            "Transfer-Encoding": "chunked"
          },
          "body": "xxxxxxxxxxxxxxxx"
        }
      ],
      "expected": [
        {
          "status": null,
          "is_exempt": false,
          "is_whitelisted": false
        }
      ]
    },
    {
      "id": "length_less_body_over_limit_is_oversize",
      "config": {},
      "geo_countries": {},
      "routes": {
        "/upload": {
          "max_request_size": 10
        }
      },
      "drives": [
        {
          "client_ip": "192.0.2.10",
          "url_path": "/upload",
          "method": "POST",
          "omit_content_length": true,
          "body": "xxxxxxxxxxxxxxxx"
        }
      ],
      "expected": [
        {
          "status": 413,
          "body": "Request too large",
          "headers": {
            "X-Content-Type-Options": "nosniff",
            "X-Frame-Options": "SAMEORIGIN",
            "X-XSS-Protection": "0",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
            "X-Permitted-Cross-Domain-Policies": "none",
            "X-Download-Options": "noopen",
            "Cross-Origin-Opener-Policy": "same-origin",
            "Cross-Origin-Resource-Policy": "same-site",
            "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
          },
          "events": [
            [
              "content_filtered",
              "request_blocked"
            ]
          ],
          "on_block": [
            {
              "check_name": "request_size_content",
              "reason": "Request body exceeds 10 bytes: 10",
              "trigger_info": "",
              "passive_mode": false,
              "client_ip": "192.0.2.10",
              "path": "/upload",
              "method": "POST",
              "status_code": 413
            }
          ]
        }
      ]
    },
    {
      "id": "chunked_body_over_limit_passive_mode_passes",
      "config": {
        "passive_mode": true
      },
      "geo_countries": {},
      "routes": {
        "/upload": {
          "max_request_size": 10
        }
      },
