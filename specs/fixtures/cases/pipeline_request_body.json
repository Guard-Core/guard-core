          "method": "POST",
          "headers": {
            "Transfer-Encoding": "chunked"
          },
          "body": "xxxxxxxxxxxxxxxx"
        }
      ],
      "expected": [
        {
          "status": null,
          "is_exempt": false,
          "is_whitelisted": false,
          "events": [
            [
              "content_filtered",
              "logged_only"
            ]
          ],
          "on_block": [
            {
              "check_name": "request_size_content",
              "reason": "Request body exceeds 10 bytes: 10",
              "trigger_info": "",
              "passive_mode": true,
              "client_ip": "192.0.2.10",
              "path": "/upload",
              "method": "POST",
              "status_code": null
            }
          ]
        }
      ]
    },
    {
      "id": "non_numeric_content_length_is_bad_request",
      "config": {},
      "geo_countries": {},
      "routes": {
        "/upload": {
          "max_request_size": 10
        }
      },
      "drives": [
        {
