    },
    {
      "id": "bodyless_methods_skip_the_content_type_filter",
      "config": {},
      "geo_countries": {},
      "routes": {
        "/json": {
          "allowed_content_types": [
            "application/json"
          ]
        }
      },
      "drives": [
        {
          "client_ip": "192.0.2.10",
          "url_path": "/json",
          "method": "GET"
        },
        {
          "client_ip": "192.0.2.10",
          "url_path": "/json",
          "method": "HEAD"
        },
        {
          "client_ip": "192.0.2.10",
          "url_path": "/json",
          "method": "DELETE"
        }
      ],
      "expected": [
        {
          "status": null,
          "is_exempt": false,
          "is_whitelisted": false
        },
        {
          "status": null,
          "is_exempt": false,
          "is_whitelisted": false
        },
        {
          "status": null,
          "is_exempt": false,
          "is_whitelisted": false
        }
      ]
    },
    {
