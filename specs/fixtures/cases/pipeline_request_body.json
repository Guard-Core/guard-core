              "content_filtered",
              "request_blocked"
            ]
          ],
          "on_block": [
            {
              "check_name": "request_size_content",
              "reason": "Request size 1 exceeds limit: 0",
              "trigger_info": "",
              "passive_mode": false,
              "client_ip": "192.0.2.10",
              "path": "/sealed",
              "method": "POST",
