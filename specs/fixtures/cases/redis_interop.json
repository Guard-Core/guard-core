{
  "suite": "redis_interop",
  "kind": "redis_interop",
  "spec_version": "4.1.0",
  "engine_version": "4.2.0",
  "doc": "Byte-level Redis interop corpus per specs/08-redis-schema.md: one operation per key family against the reference handlers pointed at a real Redis under the suite prefix. Byte equality is the standard: the pinned key string (sha256hex segments per spec), the exact stored value for static values, the member/score shape for zsets (members are engine-generated where noted), the parsed-then-canonicalized JSON blob with volatile fields dropped, and the TTL semantics (whether a TTL is set and its configured value, never the remaining time). Go, PHP, TS and Rust ports pointed at the same Redis MUST produce byte-identical results.",
  "cases": [
    {
      "id": "rio_rate_limit_global_tier",
      "prefix": "guard_core:corpus_rio:",
      "operation": {
        "op": "rate_limit",
        "handler": "ratelimit_handler.RateLimitManager",
        "call": "check_rate_limit (Lua path, global tier)",
        "args": {
          "client_ip": "203.0.113.20",
          "rate_limit": 5,
          "rate_limit_window": 60
        }
      },
      "expected": [
        {
          "key": "guard_core:corpus_rio:rate_limit:rate:203.0.113.20",
          "type": "zset",
          "ttl": {
            "set": true,
            "seconds": 120
          },
          "card": 1,
          "member_shape": "^[0-9]+\\.[0-9]+(e[+-]?[0-9]+)?$",
          "score_equals_member": true
        }
      ]
    },
    {
      "id": "rio_rate_limit_endpoint_tier",
      "prefix": "guard_core:corpus_rio:",
      "operation": {
        "op": "rate_limit",
        "handler": "ratelimit_handler.RateLimitManager",
        "call": "check_rate_limit (Lua path, endpoint tier)",
        "args": {
          "client_ip": "203.0.113.20",
          "rate_limit": 5,
          "rate_limit_window": 60,
          "endpoint_path": "/api"
        }
      },
      "expected": [
        {
          "key": "guard_core:corpus_rio:rate_limit:rate:203.0.113.20:702acf7c08d3b03b321d97b4903ad2210d87cee61dae07068d060b8d7dcbd693",
          "type": "zset",
          "ttl": {
            "set": true,
            "seconds": 120
          },
          "card": 1,
          "member_shape": "^[0-9]+\\.[0-9]+(e[+-]?[0-9]+)?$",
          "score_equals_member": true
        }
      ]
    },
    {
