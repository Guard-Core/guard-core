    {
      "id": "sqli_or_tautology",
      "input": {
        "content": "' OR 1=1--",
        "context": "request_body"
      },
      "expected": {
        "is_threat": true,
        "threat_score": 1.0,
        "threats": [
          {
            "type": "regex",
            "pattern": "(?i)('\\s*(?:OR|AND)[\\s(]*'?(?:[@:$][A-Za-z_]\\w*|[\\d\\w]+)\\s*(?:LIKE|[<>]=?|=)[\\s(]*'?(?:[@:$][A-Za-z_]\\w*|[\\d\\w]+))",
            "match": "' OR 1=1",
            "position": 0,
            "category": "sqli",
            "weight": 1.0
          },
          {
            "type": "regex",
            "pattern": "(?i)\\b(?:OR|AND)\\s*(\\d+|'[^']*'|\\\"[^\\\"]*\\\"|[@:$][A-Za-z_]\\w*)\\s*=\\s*\\1\\b(?!\\s+(?:is|are|was|means|equals|always|holds|being)\\b)",
            "match": "OR 1=1",
            "position": 2,
            "category": "sqli",
            "weight": 1.0
          }
        ],
        "original_length": 10,
        "processed_length": 10,
        "detection_method": "enhanced"
      }
    },
